generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ----------------------------------------------------
// Administradores (Espelha a tabela public.profiles)
// ----------------------------------------------------
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  role      String   @default("admin")
  password  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("profiles")
}

// ----------------------------------------------------
// Categorias (Espelha a tabela public.categories)
// ----------------------------------------------------
model Category {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique
  slug      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  products  Product[]

  @@map("categories")
}

// ----------------------------------------------------
// Catálogos (Espelha a tabela public.catalogs)
// ----------------------------------------------------
model Catalog {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  slug            String           @unique
  description     String?
  coverImage      String?          @map("cover_image")
  status          String           @default("draft") // draft, published, archived
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  catalogProducts CatalogProduct[]

  @@map("catalogs")
}

// ----------------------------------------------------
// Produtos (Espelha a tabela public.products)
// ----------------------------------------------------
model Product {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId      String?          @map("category_id") @db.Uuid
  title           String
  slug            String           @unique
  description     String?
  price           Decimal          @db.Decimal(10, 2)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category        Category?        @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  sizes           ProductSize[]
  catalogProducts CatalogProduct[]
  events          ProductEvent[]

  @@index([categoryId], map: "idx_products_category")
  @@map("products")
}

// ----------------------------------------------------
// Fotos dos Produtos (Espelha public.product_images)
// ----------------------------------------------------
model ProductImage {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  imageUrl  String  @map("image_url")
  position  Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ----------------------------------------------------
// Tamanhos e Estoque (Espelha public.product_sizes)
// ----------------------------------------------------
model ProductSize {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  size          String
  stockQuantity Int     @default(0) @map("stock_quantity")
  active        Boolean @default(true)

  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
  @@map("product_sizes")
}

// ----------------------------------------------------
// Relação Catálogo - Produtos (public.catalog_products)
// ----------------------------------------------------
model CatalogProduct {
  catalogId String  @map("catalog_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  position  Int     @default(0)

  catalog   Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([catalogId, productId])
  @@map("catalog_products")
}

// ----------------------------------------------------
// Eventos e Cliques (Espelha public.product_events)
// ----------------------------------------------------
model ProductEvent {
  id        BigInt   @id @default(autoincrement())
  productId String   @map("product_id") @db.Uuid
  eventType String   @map("event_type") // product_view, whatsapp_click
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt], map: "idx_product_events_product_date")
  @@map("product_events")
}
